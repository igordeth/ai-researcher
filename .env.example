# Variáveis de ambiente para desenvolvimento local.
# Copie para .env (gitignorado) e ajuste se precisar:  cp .env.example .env
#
# Só os scripts locais leem este arquivo (`pnpm dev` e `pnpm seed`, pela flag --env-file-if-exists
# do Node). Uma variável já definida no terminal vence o valor daqui.
# Produção nunca lê .env: no Cloud Run, DATABASE_URL vem do Secret Manager (secret database-url).

# Postgres efêmero do docker-compose (`docker compose up postgres`), visto de FORA do Docker.
# O host é localhost porque a API roda na sua máquina; o nome do serviço (`postgres`) só
# resolve dentro da rede do Docker, e é o que o serviço `api` do docker-compose usa.
# Usuário e senha são os descartáveis do docker-compose.yml, nunca os do Cloud SQL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/ai_researcher

# Modelos da Vertex AI, um por papel (ver CLAUDE.md, "Modelos"). Nunca fixos no código.
# Trocar MODEL_EMBEDDING invalida o índice inteiro: rode `pnpm seed` de novo, do zero.
MODEL_EMBEDDING=gemini-embedding-001
MODEL_GRADE=gemini-3.5-flash-lite
MODEL_ANSWER=gemini-3.6-flash
# Região dos embeddings.
GOOGLE_CLOUD_LOCATION=us-central1
# Região dos LLMs (grade e answer). Os Gemini mais recentes só respondem na região "global".
GOOGLE_CLOUD_LOCATION_LLM=global
# A autenticação na Vertex vem do ADC (`gcloud auth application-default login`), não de chave.
# O projeto GCP vem de GOOGLE_CLOUD_PROJECT ou, sem ela, do `gcloud config get project`. O quota
# project do ADC (`gcloud auth application-default set-quota-project <id>`) decide quem paga a cota.

# Busca na web, usada quando o corpus não responde (nó webSearch). serper (padrão) ou google.
# As chaves são segredos: aqui ficam vazias; preencha só no seu .env. Em produção, Secret Manager.
# DEMO=true troca o grafo inteiro por fixtures: embeddings de zeros, busca que devolve sempre a
# Vale 3T25, grade sempre suficiente e resposta fixa. Sem Vertex AI, sem Serper e sem Postgres.
# O `pnpm seed` ignora esta variável e usa sempre os embeddings reais. Aceita "true" ou "false".
DEMO=false
SEARCH_PROVIDER=serper
SERPER_API_KEY=
# Google Custom Search: fechado a novos clientes, com fim anunciado para 2027-01-01. Só para quem
# já tem chave.
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_CX=

# Rate limiting de todas as rotas da API, menos /api/health e /api/metrics (ver apps/api/src/limites.ts):
# RATE_LIMIT_MAX pedidos por cliente (IP) em cada janela de RATE_LIMIT_WINDOW milissegundos.
# Vazias, valem 30 pedidos por minuto. Valor inválido impede a API de subir.
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW=60000
# Orçamento diário de tokens dos LLMs, somado de todos os clientes, em memória e por processo. Zera
# à meia-noite UTC. Esgotado, o /api/chat responde 429 antes de começar o grafo. Vazio: 1000000.
DAILY_TOKEN_BUDGET=1000000

# Tracing na Langfuse (ver packages/agent/src/tracing/registrar.ts), registado no arranque da API e
# dos dois transportes do MCP. Sem as duas chaves, nada é registado e os processos sobem igual.
# As chaves são segredos: crie-as no projeto da Langfuse (Settings → API Keys) e preencha só no
# seu .env. Em produção, Secret Manager.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Região da Langfuse Cloud: https://cloud.langfuse.com (UE) ou https://us.cloud.langfuse.com (EUA).
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Separa os traces locais dos de produção nos dashboards da Langfuse.
LANGFUSE_TRACING_ENVIRONMENT=development
