# Variáveis de ambiente para desenvolvimento local.
# Copie para .env (gitignorado) e ajuste se precisar:  cp .env.example .env
#
# Só os scripts locais leem este arquivo (`pnpm dev` e `pnpm seed`, pela flag --env-file-if-exists
# do Node). Uma variável já definida no terminal vence o valor daqui.
# Produção nunca lê .env: no Cloud Run, DATABASE_URL vem do Secret Manager (secret database-url).

# Postgres efêmero do docker-compose (`docker compose up postgres`), visto de FORA do Docker.
# O host é localhost porque a API roda na sua máquina; o nome do serviço (`postgres`) só
# resolve dentro da rede do Docker, e é o que o serviço `api` do docker-compose usa.
# Usuário e senha são os descartáveis do docker-compose.yml, nunca os do Cloud SQL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/ai_researcher

# Modelos da Vertex AI, um por papel (ver CLAUDE.md, "Modelos"). Nunca fixos no código.
# Trocar MODEL_EMBEDDING invalida o índice inteiro: rode `pnpm seed` de novo, do zero.
MODEL_EMBEDDING=gemini-embedding-001
GOOGLE_CLOUD_LOCATION=us-central1
# A autenticação na Vertex vem do ADC (`gcloud auth application-default login`), não de chave.
# O projeto GCP vem de GOOGLE_CLOUD_PROJECT ou, sem ela, do `gcloud config get project`. O quota
# project do ADC (`gcloud auth application-default set-quota-project <id>`) decide quem paga a cota.
